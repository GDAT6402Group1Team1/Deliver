# Unreal Engine 5.8 Git ignore
# Based on GitHub UnrealEngine.gitignore and Epic's Git source control guidance:
# https://dev.epicgames.com/documentation/en-us/unreal-engine/using-git-source-control-in-unreal-engine
# https://github.com/github/gitignore/blob/main/UnrealEngine.gitignore

# Visual Studio / Rider / generated IDE files
.vs/
.idea/
.vscode/
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# These project files can be regenerated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Precompiled source art
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files (rebuild from source)
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Crash dumps and logs
*.dmp
*.log

# Packed / cooked output
*.pak
*.ucas
*.utoc
*.o.pak

# Local user / machine files
*.code-workspace
*.VC.db-wal
*.VC.db-shm
*.opendb
*.user
*.userosscache

# OS
Thumbs.db
Desktop.ini
.DS_Store
